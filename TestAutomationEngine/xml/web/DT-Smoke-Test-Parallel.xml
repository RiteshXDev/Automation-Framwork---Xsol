<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="CrossBrowserSuite"
       parallel="tests"
       thread-count="2">

    <listeners>
        <listener class-name="core.listeners.web.WebRetryListener"/>
    </listeners>

    <test name="Chrome">
        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="client.testApp.webapplicationTest.test"/>
        </classes>
    </test>

    <test name="Edge">
        <parameter name="browser" value="edge"/>

        <classes>
            <class name="client.testApp.webapplicationTest.test"/>
        </classes>
    </test>

</suite>