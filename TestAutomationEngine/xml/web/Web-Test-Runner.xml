<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="EdgeBrowserSuite"
       parallel="tests"
       thread-count="1">

    <listeners>
        <listener class-name="core.listeners.web.WebRetryListener"/>
    </listeners>


    <test name="Edge">
        <parameter name="browser" value="edge"/>
        <classes>

            <!-- 16. Expandable Panels   -->
            <class name="client.designtool.tests.ExpandablePanelsTest">
                <methods>
                    <include name="ExpandablePanelsTest_leftPanel"/>
                    <include name="ExpandablePanelsTest_rightPanel"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>